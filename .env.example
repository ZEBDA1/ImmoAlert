BOT_TOKEN=VOTRE_TOKEN_ICI
DATABASE_URL=sqlite:///data.db
PROXY_URL=
PROXY_FALLBACK_DIRECT=true
PREMIUM_FREE_DELAY_SECONDS=300
DEFAULT_SOURCE_QUOTA=5
SOURCE_QUOTA_PER_CYCLE=paruvendu=6,entreparticuliers=6,leboncoin=3,seloger=3,pap=4,logicimmo=4,rentola=4,ouestfranceimmo=4
PER_SOURCE_CONCURRENCY=4
SCRAPER_TASK_TIMEOUT_SECONDS=20
SCHEDULER_SOURCE_BACKOFF_MIN_SECONDS=60
SCHEDULER_SOURCE_BACKOFF_MAX_SECONDS=600
SOURCE_RUN_RETENTION_DAYS=14
# Regular source refresh, every 30 minutes. New searches still start immediately.
SCHEDULER_INTERVAL_SECONDS=1800
DEDUPE_WINDOW_HOURS=72
MIN_LISTING_QUALITY_FIELDS=2
# UTF-8 runtime (recommended for emoji/log compatibility)
PYTHONUTF8=1
PYTHONIOENCODING=UTF-8
# When true, ignore per-source quotas and scan all locations per cycle.
# Leave false by default to reduce rate-limit risks.
FULL_SCAN=false
EXPAND_LOCATION_VARIANTS=true
INCLUDE_GENERIC_LOCATION_PASS=false

# Geocoding
ENABLE_GEOCODING=false
GEOCODING_USER_AGENT=immobot/1.0 (contact@example.com)

# Comma-separated Telegram user IDs with admin access
ADMIN_TELEGRAM_IDS=VOTRE_ID_TELEGRAM_ICI

# ---------------------------------------------------------------------------
# Firecrawl backup (Scrapling is the primary engine)
# ---------------------------------------------------------------------------
# Optional explicit keys; otherwise the existing CLI login/keyless mode applies.
# Several keys from one account still share that account's credit allowance.
FIRECRAWL_ENABLED=true
# Legacy single key remains supported and is deduplicated against the list.
FIRECRAWL_API_KEYS=
FIRECRAWL_API_KEY=
# Optional explicit path; auto-detected from PATH / npm-global when empty.
FIRECRAWL_CLI_PATH=
# Hard ceiling for a single scrape subprocess.
FIRECRAWL_TIMEOUT_SECONDS=90
# Reuse a scraped page for this long before spending another credit.
FIRECRAWL_CACHE_TTL_SECONDS=300
# Search-result pages to fetch per source and location (each one costs a credit).
FIRECRAWL_MAX_PAGES=2
# Extra wait for client-side rendering, in milliseconds.
FIRECRAWL_WAIT_FOR_MS=1200
FIRECRAWL_COUNTRY=FR
# CLI accepts only "auto" or "basic"; anything else is ignored.
FIRECRAWL_PROXY=auto

# Primary Scrapling HTML engine. /admin can override this default without restarting;
# the panel choice is persisted in the database and takes precedence here.
SCRAPLING_ENABLED=true
SCRAPLING_TIMEOUT_SECONDS=25
# Optional local Chromium path (Docker sets /usr/bin/chromium).
SCRAPLING_BROWSER_PATH=

# FlashProxy customer API (https://www.flashproxy.com/dashboard/api).
# Enable once the key has usage + proxies permissions and an active plan.
FLASHPROXY_ENABLED=false
FLASHPROXY_API_KEY=
# Can be empty if the account has exactly one active plan.
FLASHPROXY_PLAN_ID=
# Facultatif : deux plans de la même clé API, séparés par une virgule.
# Les plans enregistrés dans l’administration ont priorité.
FLASHPROXY_PLAN_IDS=
FLASHPROXY_COUNTRY=FR
FLASHPROXY_STICKY_MINUTES=10
FLASHPROXY_TIMEOUT_SECONDS=12

# Self-hosted website: administrator-created logins; optional Telegram linking.
WEB_ENABLED=false
WEB_SITE_URL=http://localhost:8088
WEB_BIND_HOST=0.0.0.0
WEB_PORT=8088
WEB_DIST_PATH=/app/web_dist
## Optional: signed PHP gateway on Plesk shared hosting (see docs/PLESK.md).
# WEB_PROXY_ORIGIN=https://immo.example.com
# WEB_PROXY_SECRET=generate_a_random_secret_of_at_least_32_characters

# Optional SeLoger experimental mode
SELOGER_COOKIE=
SELOGER_USER_AGENT=

# Optional manual cookies for blocked sources
PAP_COOKIE=
LEBONCOIN_COOKIE=

# Selenium fallback for blocked pages (slower but can improve success rate)
USE_SELENIUM_FALLBACK=false

# Optional AI scam analysis (disabled by default)
AI_SCAM_ENABLED=false
AI_SCAM_ENDPOINT=
AI_SCAM_API_KEY=
AI_SCAM_MODEL=gpt-4o-mini
AI_SCAM_TIMEOUT=12

# Vérification adaptative des publications favorites (limites par portail conservées)
FAVORITE_FRESHNESS_TARGET_HOURS=6
FAVORITE_FRESHNESS_MAX_BATCH=12
