BOT_TOKEN=VOTRE_TOKEN_ICI
DATABASE_URL=sqlite:///data.db
PROXY_URL=
PROXY_FALLBACK_DIRECT=true
PREMIUM_FREE_DELAY_SECONDS=300
DEFAULT_SOURCE_QUOTA=5
SOURCE_QUOTA_PER_CYCLE=paruvendu=6,entreparticuliers=6,leboncoin=3,seloger=3,pap=4,logicimmo=4,rentola=4,ouestfranceimmo=4
PER_SOURCE_CONCURRENCY=4
SCRAPER_TASK_TIMEOUT_SECONDS=20
SCHEDULER_SOURCE_BACKOFF_MIN_SECONDS=60
SCHEDULER_SOURCE_BACKOFF_MAX_SECONDS=600
SOURCE_RUN_RETENTION_DAYS=14
DEDUPE_WINDOW_HOURS=72
MIN_LISTING_QUALITY_FIELDS=2
# UTF-8 runtime (recommended for emoji/log compatibility)
PYTHONUTF8=1
PYTHONIOENCODING=UTF-8
# When true, ignore per-source quotas and scan all locations per cycle.
# Leave false by default to reduce rate-limit risks.
FULL_SCAN=false
EXPAND_LOCATION_VARIANTS=true
INCLUDE_GENERIC_LOCATION_PASS=false

# Geocoding
ENABLE_GEOCODING=false
GEOCODING_USER_AGENT=immobot/1.0 (contact@example.com)

# Comma-separated Telegram user IDs with admin access
ADMIN_TELEGRAM_IDS=VOTRE_ID_TELEGRAM_ICI

# ---------------------------------------------------------------------------
# Firecrawl (required for leboncoin + seloger)
# ---------------------------------------------------------------------------
# leboncoin.fr and seloger.com sit behind DataDome/Cloudflare: plain HTTP gets
# a 403, so these two sources are scraped through the Firecrawl CLI, which
# renders the page in a stealth browser. PAP works over plain HTTP when its
# IP is not blocked.
#
# The keyless free tier works but is aggressively rate limited. For anything
# beyond a quick test, create a free key at https://firecrawl.dev and set it
# below; the CLI is then billed against your own quota.
FIRECRAWL_ENABLED=true
FIRECRAWL_API_KEY=
# Optional explicit path; auto-detected from PATH / npm-global when empty.
FIRECRAWL_CLI_PATH=
# Hard ceiling for a single scrape subprocess.
FIRECRAWL_TIMEOUT_SECONDS=90
# Reuse a scraped page for this long before spending another credit.
FIRECRAWL_CACHE_TTL_SECONDS=300
# Search-result pages to fetch per source and location (each one costs a credit).
FIRECRAWL_MAX_PAGES=2
# Extra wait for client-side rendering, in milliseconds.
FIRECRAWL_WAIT_FOR_MS=1200
FIRECRAWL_COUNTRY=FR
# CLI accepts only "auto" or "basic"; anything else is ignored.
FIRECRAWL_PROXY=auto

# Optional SeLoger experimental mode
SELOGER_COOKIE=
SELOGER_USER_AGENT=

# Optional manual cookies for blocked sources
PAP_COOKIE=
LEBONCOIN_COOKIE=

# Selenium fallback for blocked pages (slower but can improve success rate)
USE_SELENIUM_FALLBACK=false

# Optional AI scam analysis (disabled by default)
AI_SCAM_ENABLED=false
AI_SCAM_ENDPOINT=
AI_SCAM_API_KEY=
AI_SCAM_MODEL=gpt-4o-mini
AI_SCAM_TIMEOUT=12
